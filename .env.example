# =============================================================================
# CryptoTracker Environment Variables
# Copy this file to .env and adjust values for your environment
# =============================================================================

# --- Backend ---
# Secret key for JWT signing (MUST be >=32 chars in production)
SECRET_KEY=dev-secret-key-change-in-production-32chars!

# Database connection (async driver for FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cryptotracker

# Redis for caching
REDIS_URL=redis://redis:6379/0

# Celery broker (separate Redis DB to isolate from cache)
CELERY_BROKER_URL=redis://redis:6379/1

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cryptotracker

# --- Optional: LLM / External APIs ---
# OPENAI_API_KEY=sk-...
# COINGECKO_API_KEY=...
