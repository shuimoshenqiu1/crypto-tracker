# =============================================================================
# CryptoTracker Environment Variables
# Copy this file to .env and modify as needed
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cryptotracker

# --- Backend ---
# IMPORTANT: Change SECRET_KEY in production (>= 32 characters)
SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/cryptotracker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- External APIs (optional) ---
# COINGECKO_API_KEY=your-api-key-here
# BINANCE_API_KEY=your-api-key-here
# BINANCE_API_SECRET=your-api-secret-here
